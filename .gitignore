__pycache__/
*.pyc
.env
.pytest_cache/

# Patient data (PPI-removed clinical line lists) - NEVER commit.
# The admin uploads these through the Admin page after deployment.
*.xlsx
*.xlsb
*.parquet
*.parquet.zip

# local/editor cruft
.playwright-mcp/
*.png
.DS_Store
.Rhistory
.claude/settings.local.json

# Generated from TECHNICAL_DOSSIER.md for submission; regenerate rather than
# version it. Delete this line if the exact submitted artifact needs archiving.
*.docx

# dev screenshots
*.jpeg
*.jpg

# ...but brand assets are part of the app and must ship with it
!backend/static/brand/
!backend/static/brand/*.png

# Frontend (React migration). node_modules is restored by `npm ci` from the
# committed lockfile; static_app is a build artifact produced by Vite or by the
# Dockerfile's first stage, never edited by hand.
frontend/node_modules/
backend/static_app/
