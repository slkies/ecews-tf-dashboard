# Copy to .env and change every value before deploying.
# .env is gitignored - never commit real secrets. On Render/Railway/Fly set these
# in the platform's env UI, not in a committed file.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me
VIEWER_PASSWORD=change-me            # shared read-only test account (viewer@ecews.org)
CORS_ORIGINS=*
