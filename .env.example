# Copy to .env and change every value before deploying.
# .env is gitignored - never commit real secrets. On Render/Railway/Fly set these
# in the platform's env UI, not in a committed file.

# APP_ENV defaults to "production" inside the app. Leave it unset (or set it to
# production) anywhere real: that is what forces JWT_SECRET to be present.
# Only a local development box should set APP_ENV=development.
APP_ENV=production

DB_PASSWORD=change-me

# REQUIRED in production - the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating this value invalidates every issued session token, which is the
# intended way to force everyone to sign in again.
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12

# Seed accounts. NOTE: these are applied only when the account does not yet
# exist. Changing them later does NOT update an account that has already been
# created - reset that password through the admin UI instead.
ADMIN_PASSWORD=change-me
VIEWER_PASSWORD=change-me            # shared read-only test account (viewer@ecews.org)

# Brute-force lockout: N failed sign-ins for one address within the window
# blocks further attempts. Counted from the last successful sign-in.
LOGIN_LOCKOUT_FAILS=5
LOGIN_LOCKOUT_MINUTES=15

# Minimum password length, so ECEWS policy can raise it without a code change.
# Known defaults (changeme, viewer1234, ...) are refused regardless.
MIN_PASSWORD_LENGTH=10

# Usage tracking: a gap this long ends a session. There is no logout event to
# rely on, so session duration is an inferred estimate, not a measurement.
SESSION_GAP_MINUTES=30

# Set to the hosting origin(s) once known; "*" is fine only while testing.
CORS_ORIGINS=*
